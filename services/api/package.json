{
  "name": "@little-genius/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi:check": "node scripts/check-openapi.mjs",
    "test": "DATABASE_URL=postgresql://little_genius:little_genius@127.0.0.1:5432/little_genius_test prisma migrate deploy && DATABASE_URL=postgresql://little_genius:little_genius@127.0.0.1:5432/little_genius_test tsx --test test/*.test.ts",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.18.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.6.1",
    "prisma": "^6.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  }
}
