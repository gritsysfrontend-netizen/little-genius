# Local development only. Production reads these from a secrets manager.
# Do not put real credentials in this file. Do not put a client secret here.
DATABASE_URL=postgresql://little_genius:little_genius@127.0.0.1:5432/little_genius
ASSET_SIGNING_KEY=replace-with-a-local-signing-key
PUBLIC_BASE_URL=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000
FIXTURE_DIR=../../infrastructure/fixtures
CONTENT_SCHEMA_PATH=../../packages/content_schema/lesson-document.schema.json
RATE_LIMIT_MANIFEST=60
RATE_LIMIT_LESSON=120
RATE_LIMIT_ASSET=120
ASSET_URL_TTL_SECONDS=300
IDENTITY_PROVIDER=deny
