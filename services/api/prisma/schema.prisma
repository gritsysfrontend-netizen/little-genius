generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Immutable render document. The SQL migration adds the published-row trigger
/// and the payload-is-object check. Parent account tables are in the Phase 5 migration.
model ContentVersion {
  contentId       String @map("content_id")
  contentVersion  Int    @map("content_version")
  schemaVersion   String @map("schema_version")
  categoryId      String @map("category_id")
  ageMinMonths    Int    @map("age_min_months")
  ageMaxMonths    Int    @map("age_max_months")
  interactionType String @map("interaction_type")
  status          String
  payload         Json
  payloadSha256   String @map("payload_sha256")

  localizations ContentLocalization[]
  assetRefs     ContentAssetRef[]
  packItems     ContentPackItem[]

  @@id([contentId, contentVersion])
  @@map("content_versions")
}

model ContentLocalization {
  contentId       String @map("content_id")
  contentVersion  Int    @map("content_version")
  locale          String
  title           String
  instruction     String
  feedbackCorrect String @map("feedback_correct")
  reviewStatus    String @map("review_status")

  version ContentVersion @relation(fields: [contentId, contentVersion], references: [contentId, contentVersion], onDelete: Restrict)

  @@id([contentId, contentVersion, locale])
  @@map("content_localizations")
}

model MediaAsset {
  assetId      String  @id @map("asset_id")
  mediaType    String  @map("media_type")
  locale       String?
  objectKey    String  @map("object_key")
  sha256       String
  byteSize     Int     @map("byte_size")
  rightsStatus String  @map("rights_status")

  refs ContentAssetRef[]
  blob MediaAssetBlob?

  @@map("media_assets")
}

model MediaAssetBlob {
  assetId     String @id @map("asset_id")
  contentType String @map("content_type")
  bytes       Bytes

  asset MediaAsset @relation(fields: [assetId], references: [assetId], onDelete: Restrict)

  @@map("media_asset_blobs")
}

model ContentAssetRef {
  contentId      String @map("content_id")
  contentVersion Int    @map("content_version")
  assetId        String @map("asset_id")

  version ContentVersion @relation(fields: [contentId, contentVersion], references: [contentId, contentVersion], onDelete: Restrict)
  asset   MediaAsset     @relation(fields: [assetId], references: [assetId], onDelete: Restrict)

  @@id([contentId, contentVersion, assetId])
  @@map("content_asset_refs")
}

model ContentPack {
  packId         String @map("pack_id")
  packVersion    Int    @map("pack_version")
  totalBytes     Int    @map("total_bytes")
  checksumSha256 String @map("checksum_sha256")
  minAppVersion  String @map("min_app_version")
  status         String

  items ContentPackItem[]

  @@id([packId, packVersion])
  @@map("content_packs")
}

model ContentPackItem {
  packId         String @map("pack_id")
  packVersion    Int    @map("pack_version")
  contentId      String @map("content_id")
  contentVersion Int    @map("content_version")
  position       Int

  pack    ContentPack    @relation(fields: [packId, packVersion], references: [packId, packVersion], onDelete: Restrict)
  version ContentVersion @relation(fields: [contentId, contentVersion], references: [contentId, contentVersion], onDelete: Restrict)

  @@id([packId, packVersion, position])
  @@map("content_pack_items")
}

/// Staff draft. Published lesson bytes stay on content_versions.
model ContentDraft {
  id                   String   @id
  contentId            String   @map("content_id")
  authorSub            String   @map("author_sub")
  payload              Json
  educationStatus      String   @default("pending") @map("education_status")
  educationReviewerSub String?  @map("education_reviewer_sub")
  rightsStatus         String   @default("pending") @map("rights_status")
  rightsReviewerSub    String?  @map("rights_reviewer_sub")
  state                String   @default("open")
  publishedVersion     Int?     @map("published_version")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  localeReviews DraftLocaleReview[]

  @@map("content_drafts")
}

model DraftLocaleReview {
  draftId     String  @map("draft_id")
  locale      String
  status      String
  reviewerSub String? @map("reviewer_sub")

  draft ContentDraft @relation(fields: [draftId], references: [id], onDelete: Restrict)

  @@id([draftId, locale])
  @@map("draft_locale_reviews")
}

model ContentAuditEvent {
  id        String   @id
  at        DateTime @default(now())
  actorSub  String   @map("actor_sub")
  action    String
  contentId String?  @map("content_id")
  draftId   String?  @map("draft_id")
  detail    Json

  @@index([at])
  @@map("content_audit_events")
}

/// The IdP subject is stored here. Email and phone stay at the identity provider.
model ParentAccount {
  id                String    @id @default(uuid()) @db.Uuid
  authProviderSub   String    @unique @map("auth_provider_sub")
  consentStatus     String    @default("none") @map("consent_status")
  createdAt         DateTime  @default(now()) @map("created_at")
  deletedAt         DateTime? @map("deleted_at")
  sessionsRevokedAt DateTime? @map("sessions_revoked_at")

  profiles        ChildProfile[]
  consents        ConsentRecord[]
  idempotencyKeys IdempotencyKey[]
  jobs            JobOutbox[]

  @@map("parent_accounts")
}

model ChildProfile {
  id              String    @id @db.Uuid
  parentAccountId String    @map("parent_account_id") @db.Uuid
  nickname        String
  avatarId        String    @map("avatar_id")
  ageBand         String    @map("age_band")
  preferredLocale String    @map("preferred_locale")
  bilingualMode   Boolean   @map("bilingual_mode")
  revision        Int
  deletedAt       DateTime? @map("deleted_at")

  parent    ParentAccount     @relation(fields: [parentAccountId], references: [id], onDelete: Restrict)
  events    LearningEvent[]
  summaries ProgressSummary[]

  @@index([parentAccountId])
  @@map("child_profiles")
}

model LearningEvent {
  eventId        String   @id @map("event_id") @db.Uuid
  profileId      String   @map("profile_id") @db.Uuid
  contentId      String   @map("content_id")
  contentVersion Int      @map("content_version")
  eventType      String   @map("event_type")
  durationBucket String?  @map("duration_bucket")
  occurredAt     DateTime @map("occurred_at")

  profile ChildProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@index([profileId])
  @@map("learning_events")
}

model ProgressSummary {
  profileId      String    @map("profile_id") @db.Uuid
  categoryId     String    @map("category_id")
  startedCount   Int       @default(0) @map("started_count")
  completedCount Int       @default(0) @map("completed_count")
  lastActivityAt DateTime? @map("last_activity_at")

  profile ChildProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@id([profileId, categoryId])
  @@map("progress_summaries")
}

/// Kept when an account is deleted. The foreign key is ON DELETE RESTRICT.
model ConsentRecord {
  recordId        String   @id @default(uuid()) @map("record_id") @db.Uuid
  parentAccountId String   @map("parent_account_id") @db.Uuid
  purpose         String
  noticeVersion   String   @map("notice_version")
  decision        String
  createdAt       DateTime @default(now()) @map("created_at")

  parent ParentAccount @relation(fields: [parentAccountId], references: [id], onDelete: Restrict)

  @@index([parentAccountId])
  @@map("consent_records")
}

model IdempotencyKey {
  parentAccountId String   @map("parent_account_id") @db.Uuid
  key             String   @db.Uuid
  requestSha256   String   @map("request_sha256")
  statusCode      Int      @map("status_code")
  responseBody    Json     @map("response_body")
  createdAt       DateTime @default(now()) @map("created_at")

  parent ParentAccount @relation(fields: [parentAccountId], references: [id], onDelete: Restrict)

  @@id([parentAccountId, key])
  @@map("idempotency_keys")
}

/// Operational job arguments. This JSON is not a lesson document.
model JobOutbox {
  jobId           String    @id @default(uuid()) @map("job_id") @db.Uuid
  parentAccountId String    @map("parent_account_id") @db.Uuid
  jobType         String    @map("job_type")
  payload         Json
  status          String    @default("pending")
  availableAt     DateTime  @default(now()) @map("available_at")
  attempts        Int       @default(0)
  result          Json?
  finishedAt      DateTime? @map("finished_at")

  parent ParentAccount @relation(fields: [parentAccountId], references: [id], onDelete: Restrict)

  @@index([status, availableAt])
  @@map("job_outbox")
}
